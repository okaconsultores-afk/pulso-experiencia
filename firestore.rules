rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Una evaluación: la crea y la modifica solo quien la creó. Cualquiera con el código la puede leer.
    match /evaluaciones/{codigo} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.duenio == request.auth.uid
        && request.resource.data.momentos is list
        && request.resource.data.momentos.size() >= 2
        && request.resource.data.momentos.size() <= 4;
      allow update: if request.auth != null
        && resource.data.duenio == request.auth.uid
        && request.resource.data.duenio == resource.data.duenio
        && request.resource.data.momentos.size() >= 2
        && request.resource.data.momentos.size() <= 4;
      allow delete: if request.auth != null && resource.data.duenio == request.auth.uid;

      // Respuestas: cada participante escribe solo su propio documento (uno por dispositivo).
      match /respuestas/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nombre', 'r'])
          && request.resource.data.r is map
          && request.resource.data.r.size() <= 4;
        allow delete: if request.auth != null
          && (request.auth.uid == uid
              || get(/databases/$(database)/documents/evaluaciones/$(codigo)).data.duenio == request.auth.uid);
      }
    }
  }
}
